# Smart Irrigation System Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration (Required)
DATABASE_URL=postgresql://username:password@localhost:5432/irrigation_db

# Session Security (Required)
# Generate a secure random string for session encryption
SESSION_SECRET=your-super-secure-random-string-here-change-this

# Weather API Keys (Optional - choose one)
# Get free API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key

# Alternative: WeatherAPI (https://www.weatherapi.com/)
WEATHER_API_KEY=your-weather-api-key

# Application Configuration
NODE_ENV=development
PORT=5000

# Database Connection Pool (Optional)
# Uncomment and adjust if needed
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# Logging Level (Optional)
# LOG_LEVEL=info

# Example Database URLs for different providers:
# Neon (Recommended): postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Local PostgreSQL: postgresql://postgres:password@localhost:5432/irrigation_system
# Railway: postgresql://postgres:password@containers-us-west-xxx.railway.app:5432/railway
# Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres