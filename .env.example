# Smart Irrigation System Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration (Required) - MySQL
DATABASE_URL=mysql://root:password@localhost:3306/irrigation_system

# Session Security (Required)
# Generate a secure random string for session encryption
SESSION_SECRET=your-super-secure-random-string-here-change-this

# Weather API Keys (Optional - choose one)
# Get free API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key

# Alternative: WeatherAPI (https://www.weatherapi.com/)
WEATHER_API_KEY=your-weather-api-key

# Arduino Integration (Optional)
# Set to 'true' to receive real sensor data from Arduino boards
ENABLE_REAL_SENSORS=false

# API key for Arduino authentication (optional but recommended)
ARDUINO_API_KEY=your-secure-arduino-api-key

# Serial port for direct Arduino connection (alternative to WiFi)
ARDUINO_SERIAL_PORT=/dev/ttyUSB0

# Application Configuration
NODE_ENV=development
PORT=5000

# Database Connection Pool (Optional)
# Uncomment and adjust if needed
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# Logging Level (Optional)
# LOG_LEVEL=info

# Example Database URLs for different providers:
# Local MySQL: mysql://root:password@localhost:3306/irrigation_system
# PlanetScale: mysql://username:password@aws.connect.psdb.cloud/database?ssl={"rejectUnauthorized":true}
# Railway MySQL: mysql://root:password@containers-us-west-xxx.railway.app:3306/railway
# AWS RDS: mysql://admin:password@database.xxxxx.us-east-1.rds.amazonaws.com:3306/irrigation_system